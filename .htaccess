Options -Indexes

# Force HTTPS
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Force www
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirect .html URLs to clean URLs (preserves Google's indexed pages)
RewriteCond %{THE_REQUEST} /([^.]+)\.html[\s?/] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# Location pages: /bin-rentals/<town> is served from bin-rentals-<town>.html
# (flat files, because a bin-rentals/ directory would break /bin-rentals).
# Add the next service by copying these three rules with its slug.
RewriteRule ^bin-rentals/([a-z-]+)/$ /bin-rentals/$1 [R=301,L]
RewriteRule ^bin-rentals-([a-z-]+)$ /bin-rentals/$1 [R=301,L]
RewriteCond %{DOCUMENT_ROOT}/bin-rentals-$1.html -f
RewriteRule ^bin-rentals/([a-z-]+)$ bin-rentals-$1.html [L]

# Dev-only files (local preview config, build scripts) are not public
RewriteRule ^(serve\.json|scripts/) - [F,L]

# Serve clean URLs by internally rewriting to .html files
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^.]+)$ $1.html [L]

# Custom error pages
ErrorDocument 404 /index.html
